# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always be LF â€” CRLF breaks the shebang line on
# Linux ("bad interpreter: /bin/bash\r: No such file or directory"),
# which silently fails the .deb / .rpm postinst hook (#395).
*.sh text eol=lf

# Portable build inputs (embedded Python + agent venv): store byte-for-byte, no
# EOL conversion, so scripts/build-portable.ps1 runs from a fresh clone.
runtime/python/** -text -eol
runtime/hermes/hermes-agent/** -text -eol